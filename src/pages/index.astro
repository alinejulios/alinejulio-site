---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricCorners from '../components/GeometricCorners.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FrentesAtuacao from '../components/FrentesAtuacao.astro';
import CTABlock from '../components/CTABlock.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';
import { palestras } from '../data/palestras';
import { DESCRICAO_1A_PESSOA, LINKS } from '../data/site';
import { CTA } from '../data/contato';

const palestrasRecentes = palestras.filter((p) => p.publico).slice(0, 3);
---

<BaseLayout
  title="Aline Julio | CRO Specialist, Content Designer e UX Writer"
  description="Desde 2019, Aline Julio une análise de dados, SEO On-Page e gestão de conteúdo em projetos B2B e B2C, com palestras e mentorias em UX Writing e SEO."
>
  <!-- HERO (branco gelo + composição geométrica de canto) -->
  <section class="relative overflow-hidden border-b border-brand-gray-300 bg-brand-ice pb-12 pt-8 sm:pb-16 sm:pt-12 md:pb-24 md:pt-20">
    <GeometricCorners composition="B" position="top-right" />

    <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:gap-16 lg:px-8">
      <div>
        <p class="badge badge-outline mb-5 sm:mb-6">CRO Specialist · Content Designer · UX Writer</p>

        <h1 class="mb-5 text-[30px] font-extrabold leading-[1.1] tracking-tight text-brand-black min-[375px]:text-4xl sm:mb-6 sm:text-5xl md:text-4xl lg:text-5xl xl:text-[56px]">
          Encontro onde seu site perde conversões e reescrevo o caminho até o clique
        </h1>

        <p class="mb-6 text-base leading-relaxed text-brand-gray-700 sm:mb-8 sm:text-lg lg:text-xl">
          {DESCRICAO_1A_PESSOA}
        </p>

        <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
          <a href={CTA.consultoria.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>{CTA.consultoria.label}</span>
            <PhosphorIcon name="arrow-up-right" size={20} />
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
          <a href="/palestras/" class="btn btn-secondary">
            <span>Ver palestras e aulas</span>
            <PhosphorIcon name="arrow-right" size={20} />
          </a>
        </div>

        <!-- Credenciais -->
        <p class="mt-6 text-sm font-medium text-brand-black">
          Palestrante no <a href={LINKS.seocamp} target="_blank" rel="noopener noreferrer" class="text-link inline-block py-3">SEOcamp<span class="sr-only"> (abre em nova aba)</span></a>
          {' '}<span aria-hidden="true">·</span>{' '}
          Professora na <a href={LINKS.educaseo} target="_blank" rel="noopener noreferrer" class="text-link inline-block py-3">EducaSEO<span class="sr-only"> (abre em nova aba)</span></a>
        </p>
      </div>

      <div class="hidden md:block">
        <img
          src="/images/sobre/aline-palco.jpg"
          alt="Aline Julio palestrando com microfone no palco do SEOcamp, ao lado do slide “O que é sucesso em CRO?”"
          width="800"
          height="800"
          fetchpriority="high"
          class="aspect-square w-full rounded-md border border-brand-gray-300 object-cover"
        />
      </div>
    </div>
  </section>

  <!-- O QUE EU FAÇO -->
  <section class="border-b border-brand-gray-300 bg-brand-ice py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <SectionLabel>Atuação</SectionLabel>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-brand-black">O que eu faço</h2>
      </div>
      <FrentesAtuacao />
    </div>
  </section>

  <!-- PALESTRAS RECENTES -->
  <section class="border-b border-brand-gray-300 bg-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <SectionLabel tone="white">Docência & Eventos</SectionLabel>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-brand-black">Aulas e palestras recentes</h2>
        </div>
        <a href="/palestras/" class="text-link inline-flex min-h-11 items-center gap-2 text-sm text-brand-black">
          <span>Ver palestras e aulas</span>
          <PhosphorIcon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {palestrasRecentes.map((item) => (
          <li class="flex">
            <a href={`/palestras/#${item.id}`} class="card flex w-full flex-col justify-between p-6">
              <div>
                <div class="mb-3 flex flex-col gap-1 text-sm">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-red">{item.tipo}</span>
                  <time datetime={item.dataISO} class="text-brand-gray-700">{item.dataTexto}</time>
                </div>
                <h3 class="mb-2 text-lg font-bold leading-snug text-brand-black">{item.titulo}</h3>
                <p class="mb-4 text-sm font-medium text-brand-gray-700">{item.eventoTexto}</p>
                <p class="line-clamp-3 text-sm leading-relaxed text-brand-gray-700">{item.descricao}</p>
              </div>
              <div class="mt-6 border-t border-brand-gray-300 pt-4">
                <span class="tag">{item.tema}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABlock title="Vamos falar sobre dados, conversão e conteúdo?" primary={CTA.consultoria} secondary={CTA.palestra}>
    Fale comigo sobre consultoria ou convites para palestras, aulas e mentorias.
  </CTABlock>
</BaseLayout>
