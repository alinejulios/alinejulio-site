---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';
---

<BaseLayout title="Página não encontrada" description="O endereço pode ter mudado." noindex>
  <section class="bg-brand-ice py-20 md:py-32">
    <div class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-4 sm:px-6 lg:px-8">
      <!-- Aspas da marca ampliadas: único elemento gráfico da página -->
      <svg class="h-24 w-[122px] text-brand-red md:h-32 md:w-[162px]" viewBox="0.034 -0.742 0.43 0.34" fill="currentColor" aria-hidden="true">
        <path d="M0.218,-0.742L0.152,-0.502L0.13,-0.592C0.159,-0.592 0.182,-0.584 0.2,-0.567C0.218,-0.55 0.227,-0.527 0.227,-0.498C0.227,-0.469 0.218,-0.446 0.2,-0.429C0.181,-0.411 0.158,-0.402 0.131,-0.402C0.103,-0.402 0.08,-0.411 0.062,-0.429C0.043,-0.446 0.034,-0.469 0.034,-0.498C0.034,-0.507 0.035,-0.515 0.036,-0.524C0.037,-0.532 0.04,-0.542 0.044,-0.553C0.048,-0.564 0.054,-0.579 0.061,-0.598L0.119,-0.742L0.218,-0.742ZM0.454,-0.742L0.388,-0.502L0.366,-0.592C0.395,-0.592 0.418,-0.584 0.436,-0.567C0.454,-0.55 0.463,-0.527 0.463,-0.498C0.463,-0.469 0.454,-0.446 0.436,-0.429C0.417,-0.411 0.394,-0.402 0.367,-0.402C0.339,-0.402 0.316,-0.411 0.298,-0.429C0.279,-0.446 0.27,-0.469 0.27,-0.498C0.27,-0.507 0.271,-0.515 0.272,-0.524C0.273,-0.532 0.276,-0.542 0.28,-0.553C0.284,-0.564 0.29,-0.579 0.297,-0.598L0.355,-0.742L0.454,-0.742Z" />
      </svg>

      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-brand-black sm:text-5xl">Página não encontrada</h1>
      <p class="text-lg leading-relaxed text-brand-gray-700">O endereço pode ter mudado.</p>

      <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
        <a href="/" class="btn btn-primary">
          <span>Ir para o início</span>
          <PhosphorIcon name="arrow-right" size={20} />
        </a>
        <a href="/palestras/" class="btn btn-secondary">
          <span>Ver palestras e aulas</span>
          <PhosphorIcon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
