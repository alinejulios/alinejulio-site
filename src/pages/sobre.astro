---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricCorners from '../components/GeometricCorners.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Quote from '../components/Quote.astro';
import FrentesAtuacao from '../components/FrentesAtuacao.astro';
import CTABlock from '../components/CTABlock.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';
import BalloonFrame from '../components/BalloonFrame.astro';
import { profilePageNode } from '../data/schema';
import { DESCRICAO_3A_PESSOA, TITULO_PROFISSIONAL } from '../data/site';
import { CTA } from '../data/contato';

// Padrão dos cargos: só a primeira letra maiúscula (exceto siglas), mais recente
// primeiro, como no LinkedIn. Com mais de um cargo na mesma organização, cada
// um leva o próprio período entre parênteses.
const experiencia = [
  {
    periodo: '2025 até hoje',
    org: 'Direcional Engenharia',
    url: 'https://www.direcional.com.br/',
    funcoes: ['Analista de UX e CRO'],
  },
  {
    periodo: '2025 até hoje',
    org: 'EducaSEO',
    url: 'https://educaseo.com.br/',
    funcoes: ['Professora especialista'],
  },
  {
    periodo: '2023 a 2025',
    org: 'Cruzeiro do Sul Educacional',
    url: 'https://www.cruzeirodosuleducacional.com.br/',
    funcoes: ['Analista de conteúdo em UX e SEO (2024 a 2025)', 'Analista de conteúdo em CRM (2023 a 2024)'],
  },
  {
    periodo: '2019 a 2023',
    org: 'Studio Visual',
    url: 'https://studiovisual.com.br/',
    funcoes: ['Analista de conteúdo em UX e SEO (2019 a 2023)', 'Redatora estagiária (2019)'],
  },
];

const formacao = [
  {
    periodo: '2024 a 2025',
    org: 'Universidade Cruzeiro do Sul',
    url: 'https://www.cruzeirodosul.edu.br/',
    funcoes: ['CST em Design de Experiência'],
  },
  {
    periodo: '2022 a 2023',
    org: 'Universidade Anhembi Morumbi',
    url: 'https://portal.anhembi.br/',
    funcoes: ['MBA em Marketing Estratégico'],
  },
  {
    periodo: '2017 a 2021',
    org: 'Universidade Cruzeiro do Sul',
    url: 'https://www.cruzeirodosul.edu.br/',
    funcoes: ['Bacharelado em Jornalismo'],
  },
];

const linhas = [
  { titulo: 'Experiência', itens: experiencia },
  { titulo: 'Formação', itens: formacao },
];

const fotos = [
  { src: '/images/sobre/aline-palco.jpg', alt: 'Aline Julio palestrando com microfone no palco do SEOcamp, ao lado do slide “O que é sucesso em CRO?”' },
  { src: '/images/sobre/aline-seocamp.jpg', alt: 'Aline Julio, com crachá do evento, diante do painel do SEOcamp “Eu faço parte da maior comunidade de SEO do Brasil”' },
  { src: '/images/sobre/aline-laptop.jpg', alt: 'Aline Julio sorrindo, sentada com um notebook no colo diante de uma parede de plantas' },
];
---

<BaseLayout
  title="Sobre Aline Julio | CRO Specialist e UX Writer"
  description="Trajetória de Aline Julio desde 2019 em dados, SEO e conteúdo, com passagens por Cruzeiro do Sul Educacional, Direcional Engenharia e EducaSEO."
  schema={[profilePageNode]}
>
  <!-- CABEÇALHO (branco gelo + elemento geométrico) -->
  <section class="relative overflow-hidden border-b border-brand-gray-300 bg-brand-ice pb-16 pt-12 md:pb-24 md:pt-20">
    <GeometricCorners composition="A" position="top-right" />

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col-reverse gap-8 md:flex-row md:items-center md:gap-10">
        <div class="grow">
          <SectionLabel class="mb-4">Trajetória profissional</SectionLabel>

          <h1 class="mb-4 text-4xl font-extrabold leading-tight tracking-tight text-brand-black sm:text-5xl">
            Sobre <span class="whitespace-nowrap">Aline Julio</span>
          </h1>

          <p class="mb-6 text-base font-semibold leading-snug text-brand-black">{TITULO_PROFISSIONAL}</p>

          <p class="text-lg leading-relaxed text-brand-gray-700 sm:text-xl">{DESCRICAO_3A_PESSOA}</p>
        </div>

        <div class="shrink-0 self-start md:self-auto">
          <BalloonFrame
            src="/images/aline-headshot.jpg"
            alt="Retrato de Aline Julio"
            width={400}
            height={400}
            loading="eager"
            class="w-60 md:w-80"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CONTEÚDO PRINCIPAL (fundo branco para textos longos) -->
  <section class="border-b border-brand-gray-300 bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl space-y-16 px-4 sm:px-6 lg:px-8">

      <div class="space-y-6 leading-relaxed text-brand-gray-700">
        <p class="text-lg leading-relaxed">
          Com experiência sólida em gestão de conteúdo e SEO On-Page <strong>desde 2019</strong>, minha carreira se desenvolveu a partir de uma constatação prática: <strong>atrair tráfego qualificado é apenas metade da equação</strong>. Sem uma estratégia clara de produção, arquitetura de informação intuitiva e acompanhamento de indicadores reais de conversão, os números estagnam.
        </p>
        <p class="text-lg leading-relaxed">
          Hoje, atuo na interseção entre <strong>gestão de conteúdo, branding digital e otimização de conversão (CRO)</strong>, atendendo projetos <strong>B2C</strong> (especialmente em educação e construção civil) e <strong>B2B</strong> (em empreendedorismo, finanças e tecnologia). Minha atuação é estratégica: estruturar processos de produção, governança editorial e metas quantitativas para que cada ativo gere valor mensurável à marca.
        </p>
      </div>

      <!-- Linha do tempo -->
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        {linhas.map((linha) => (
          <div>
            <SectionLabel tone="white" as="h2" class="mb-6">{linha.titulo}</SectionLabel>
            <ol class="space-y-6 border-l-2 border-brand-gray-300 pl-6">
              {linha.itens.map((item) => (
                <li class="relative">
                  <span aria-hidden="true" class="absolute -left-[31px] top-1.5 h-2.5 w-2.5 rounded-full bg-brand-red"></span>
                  <p class="text-sm font-semibold text-brand-gray-700">{item.periodo}</p>
                  <h3 class="text-lg font-bold leading-snug text-brand-black">
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-link inline-flex min-h-11 items-center gap-1.5">
                        <span>{item.org}</span>
                        <PhosphorIcon name="arrow-up-right" size={16} />
                        <span class="sr-only"> (abre em nova aba)</span>
                      </a>
                    ) : (
                      item.org
                    )}
                  </h3>
                  <ul class="text-base text-brand-gray-700">
                    {item.funcoes.map((f) => <li>{f}</li>)}
                  </ul>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      <!-- Galeria -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
        {fotos.map((foto) => (
          <BalloonFrame src={foto.src} alt={foto.alt} width={800} height={800} class="w-full" />
        ))}
      </div>

      <Quote attribution="Aline Julio">Conteúdo autêntico não é sobre soar perfeito — é sobre soar como você.</Quote>
    </div>
  </section>

  <!-- O QUE EU FAÇO -->
  <section class="border-b border-brand-gray-300 bg-brand-ice py-16 md:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <SectionLabel class="mb-3">Atuação</SectionLabel>
      <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-brand-black">O que eu faço</h2>
      <FrentesAtuacao />
    </div>
  </section>

  <!-- DOCÊNCIA -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-brand-black">Docência, mentorias e palestras</h2>
      <p class="mb-6 text-base leading-relaxed text-brand-gray-700">
        Acredito na troca ativa e no compartilhamento prático de conhecimento. Atuo como <strong>professora, palestrante e mentora</strong> em eventos, empresas e iniciativas do setor, com formações práticas em:
      </p>

      <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="card flex items-start gap-3 p-4">
          <PhosphorIcon name="chat-teardrop-text" size={24} class="mt-0.5 text-brand-red" />
          <div>
            <h3 class="text-base font-bold text-brand-black">UX Writing</h3>
            <p class="mt-1 text-sm text-brand-gray-700">Microcopy, clareza e testes com usuários.</p>
          </div>
        </div>
        <div class="card flex items-start gap-3 p-4">
          <PhosphorIcon name="magnifying-glass" size={24} class="mt-0.5 text-brand-red" />
          <div>
            <h3 class="text-base font-bold text-brand-black">SEO Semântico</h3>
            <p class="mt-1 text-sm text-brand-gray-700">Entidades, E-E-A-T e intenção de busca.</p>
          </div>
        </div>
        <div class="card flex items-start gap-3 p-4">
          <PhosphorIcon name="chart-line-up" size={24} class="mt-0.5 text-brand-red" />
          <div>
            <h3 class="text-base font-bold text-brand-black">CRO</h3>
            <p class="mt-1 text-sm text-brand-gray-700">Testes A/B, heurísticas e otimização de conversão.</p>
          </div>
        </div>
      </div>

      <a href="/palestras/" class="btn btn-secondary">
        <span>Ver palestras e aulas</span>
        <PhosphorIcon name="arrow-right" size={20} />
      </a>
    </div>
  </section>

  <CTABlock title="Vamos conversar?" primary={CTA.palestra} secondary={CTA.linkedin}>
    Fale comigo sobre consultoria ou convites para palestras, aulas e mentorias.
  </CTABlock>
</BaseLayout>
