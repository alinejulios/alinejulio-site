---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricCorners from '../components/GeometricCorners.astro';
import SectionLabel from '../components/SectionLabel.astro';
import CTABlock from '../components/CTABlock.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';
import { palestras } from '../data/palestras';
import { eventListNode } from '../data/schema';
import { CTA } from '../data/contato';

const schema = [eventListNode(palestras)];
---

<BaseLayout
  title="Palestras e aulas de Aline Julio"
  description="Palestras, aulas e mentorias de Aline Julio em CRO, UX Writing e SEO Semântico, no SEOcamp, na EducaSEO e em empresas."
  schema={schema}
>
  <!-- CABEÇALHO -->
  <section class="relative overflow-hidden border-b border-brand-gray-300 bg-brand-ice pb-16 pt-12 md:pb-24 md:pt-20">
    <GeometricCorners composition="B" position="top-right" />

    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <SectionLabel class="mb-4">Docência & Comunidade</SectionLabel>

      <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tight text-brand-black sm:text-5xl">
        Palestras, aulas e <span class="text-brand-red">mentorias</span>
      </h1>

      <p class="max-w-2xl text-lg leading-relaxed text-brand-gray-700 sm:text-xl">
        Palestras, aulas e mentorias em CRO, UX Writing e SEO Semântico para eventos, empresas e universidades.
      </p>
    </div>
  </section>

  <!-- LISTA -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex flex-col justify-between gap-4 border-b border-brand-gray-300 pb-6 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-2xl font-extrabold tracking-tight text-brand-black">Histórico de palestras e aulas</h2>
          <p class="mt-1 text-sm text-brand-gray-700">
            Formatos voltados para capacitação prática e debate aprofundado com foco em dados e usabilidade.
          </p>
        </div>
        <a href={CTA.palestra.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary shrink-0 whitespace-nowrap text-sm">
          <span>{CTA.palestra.label}</span>
          <PhosphorIcon name="arrow-up-right" size={20} />
          <span class="sr-only"> (abre em nova aba)</span>
        </a>
      </div>

      <div class="space-y-6">
        {palestras.map((item) => (
          <article id={item.id} class="card scroll-mt-28 p-6 md:p-8">
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
              <div class="grow space-y-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="badge badge-red">{item.tipo}</span>
                  <span class="text-sm font-semibold text-brand-gray-700">
                    <time datetime={item.dataISO}>{item.dataTexto}</time> · {item.localTexto}
                  </span>
                  <span class="tag">{item.tema}</span>
                </div>

                <h3 class="text-xl font-extrabold leading-snug tracking-tight text-brand-black md:text-2xl">{item.titulo}</h3>
                <p class="text-sm font-semibold text-brand-black">{item.eventoTexto}</p>

                {item.coautoras && (
                  <p class="text-sm text-brand-black">
                    Com{' '}
                    {item.coautoras.map((c, i) => (
                      <>
                        {i > 0 && (i === item.coautoras!.length - 1 ? ' e ' : ', ')}
                        <a href={c.linkedin} target="_blank" rel="noopener noreferrer" class="text-link inline-block py-3">
                          {c.nome}<span class="sr-only"> (LinkedIn, abre em nova aba)</span>
                        </a>
                      </>
                    ))}
                  </p>
                )}

                {item.descricao && <p class="pt-1 text-base leading-relaxed text-brand-gray-700">{item.descricao}</p>}
                {item.topicos && (
                  <ul class="list-disc space-y-2 pl-5 text-base leading-relaxed text-brand-gray-700">
                    {item.topicos.map((t) => <li>{t}</li>)}
                  </ul>
                )}

                {(item.linkComplementar || item.publicacao) && (
                  <p>
                    {[item.linkComplementar, item.publicacao].filter(Boolean).map((l) => (
                      <a href={l!.href} target="_blank" rel="noopener noreferrer" class="text-link inline-flex min-h-11 items-center gap-1.5 text-sm text-brand-black">
                        <span>{l!.rotulo}</span>
                        <PhosphorIcon name="arrow-up-right" size={16} />
                        <span class="sr-only"> (abre em nova aba)</span>
                      </a>
                    ))}
                  </p>
                )}
              </div>

              {item.slides && (
                <div class="shrink-0 pt-2 md:pt-0">
                  <a href={item.slides.href} download class="btn btn-secondary px-4 text-sm">
                    <PhosphorIcon name="download-simple" size={20} />
                    <span>Baixar slides (PDF, {item.slides.tamanho})</span>
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABlock title="Quer levar uma palestra ou mentoria para sua equipe?" primary={CTA.palestra} secondary={CTA.linkedin}>
    Estruturo apresentações e treinamentos sob medida em CRO, UX Writing e SEO Semântico, com estudos de caso reais e exercícios práticos.
  </CTABlock>
</BaseLayout>
