---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Nós JSON-LD específicos da página (ProfilePage, ItemList etc.) */
  schema?: object[];
  noindex?: boolean;
}

const { title, description, image, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} />
    <SchemaGraph nodes={schema} />
  </head>
  <body class="flex min-h-screen flex-col bg-brand-ice font-sans text-brand-black antialiased selection:bg-brand-red selection:text-white">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
