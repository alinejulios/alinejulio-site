---
import PhosphorIcon from './PhosphorIcon.astro';
import { WHATSAPP_FLUTUANTE } from '../data/contato';
---

<!-- Exceção de cor aprovada: o verde do WhatsApp só existe neste botão. -->
<a
  id="whatsapp-button"
  href={WHATSAPP_FLUTUANTE}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Conversar no WhatsApp"
  title="Conversar no WhatsApp (abre em nova aba)"
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white transition-[background-color,opacity] duration-150 hover:bg-whatsapp-hover"
>
  <PhosphorIcon name="whatsapp-logo" weight="fill" size={30} />
</a>

<script is:inline src="/scripts/whatsapp-button.js" defer></script>
