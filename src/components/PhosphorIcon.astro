---
// Phosphor Icons (MIT) é a única família de ícones da marca, inclusive para
// logos de redes sociais. Os SVGs vêm direto do pacote oficial @phosphor-icons/core
// e são embutidos no HTML (sem requisição extra e sem script de terceiros).
// Peso Regular por padrão; Bold automaticamente abaixo de 20px; Fill só quando pedido.
import listRegular from '@phosphor-icons/core/assets/regular/list.svg?raw';
import listBold from '@phosphor-icons/core/assets/bold/list-bold.svg?raw';
import xRegular from '@phosphor-icons/core/assets/regular/x.svg?raw';
import xBold from '@phosphor-icons/core/assets/bold/x-bold.svg?raw';
import linkedinRegular from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import linkedinBold from '@phosphor-icons/core/assets/bold/linkedin-logo-bold.svg?raw';
import instagramRegular from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import instagramBold from '@phosphor-icons/core/assets/bold/instagram-logo-bold.svg?raw';
import xLogoRegular from '@phosphor-icons/core/assets/regular/x-logo.svg?raw';
import xLogoBold from '@phosphor-icons/core/assets/bold/x-logo-bold.svg?raw';
import whatsappFill from '@phosphor-icons/core/assets/fill/whatsapp-logo-fill.svg?raw';
import arrowRightRegular from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowRightBold from '@phosphor-icons/core/assets/bold/arrow-right-bold.svg?raw';
import arrowUpRightRegular from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import arrowUpRightBold from '@phosphor-icons/core/assets/bold/arrow-up-right-bold.svg?raw';
import downloadRegular from '@phosphor-icons/core/assets/regular/download-simple.svg?raw';
import downloadBold from '@phosphor-icons/core/assets/bold/download-simple-bold.svg?raw';
import checkCircleRegular from '@phosphor-icons/core/assets/regular/check-circle.svg?raw';
import checkCircleBold from '@phosphor-icons/core/assets/bold/check-circle-bold.svg?raw';
import chartRegular from '@phosphor-icons/core/assets/regular/chart-line-up.svg?raw';
import chartBold from '@phosphor-icons/core/assets/bold/chart-line-up-bold.svg?raw';
import searchRegular from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import searchBold from '@phosphor-icons/core/assets/bold/magnifying-glass-bold.svg?raw';
import chatRegular from '@phosphor-icons/core/assets/regular/chat-teardrop-text.svg?raw';
import chatBold from '@phosphor-icons/core/assets/bold/chat-teardrop-text-bold.svg?raw';

const icons = {
  'list': { regular: listRegular, bold: listBold },
  'x': { regular: xRegular, bold: xBold },
  'linkedin-logo': { regular: linkedinRegular, bold: linkedinBold },
  'instagram-logo': { regular: instagramRegular, bold: instagramBold },
  'x-logo': { regular: xLogoRegular, bold: xLogoBold },
  'whatsapp-logo': { fill: whatsappFill },
  'arrow-right': { regular: arrowRightRegular, bold: arrowRightBold },
  'arrow-up-right': { regular: arrowUpRightRegular, bold: arrowUpRightBold },
  'download-simple': { regular: downloadRegular, bold: downloadBold },
  'check-circle': { regular: checkCircleRegular, bold: checkCircleBold },
  'chart-line-up': { regular: chartRegular, bold: chartBold },
  'magnifying-glass': { regular: searchRegular, bold: searchBold },
  'chat-teardrop-text': { regular: chatRegular, bold: chatBold },
} as const;

type IconName = keyof typeof icons;
type Weight = 'regular' | 'bold' | 'fill';

interface Props {
  name: IconName;
  size?: number;
  weight?: Weight;
  class?: string;
}

const { name, size = 24, weight, class: className = '' } = Astro.props;

const variants = icons[name] as Partial<Record<Weight, string>>;
const chosen: Weight = weight ?? (variants.fill && !variants.regular ? 'fill' : size < 20 ? 'bold' : 'regular');
const raw = variants[chosen] ?? Object.values(variants)[0]!;
// Mantém só o conteúdo interno do <svg> oficial (os <path>).
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={`shrink-0 ${className}`}
  set:html={inner}
/>
