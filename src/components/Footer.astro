---
import Logo from './Logo.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import SectionLabel from './SectionLabel.astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t-4 border-brand-red bg-brand-black pb-12 pt-16 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 border-b border-brand-gray-700 pb-12 md:grid-cols-12">

      <!-- Marca e posicionamento -->
      <div class="space-y-4 md:col-span-6">
        <Logo variant="dark" />
        <p class="max-w-md pt-2 text-sm leading-relaxed text-brand-gray-300">
          CRO Specialist & Estrategista de Marketing. Otimização de conversão, dados e estratégia de conteúdo para marcas e produtos com propósito.
        </p>
        <p class="text-sm font-light italic text-brand-gray-300">
          “Conteúdo autêntico não é sobre soar perfeito — é sobre soar como você.”
        </p>
      </div>

      <!-- Navegação -->
      <div class="space-y-3 md:col-span-3">
        <SectionLabel tone="dense" as="span">Navegação</SectionLabel>
        <ul class="text-sm text-brand-gray-300">
          <li><a href="/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Início</a></li>
          <li><a href="/sobre/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Sobre Aline Julio</a></li>
          <li><a href="/palestras/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Palestras & Aulas</a></li>
        </ul>
      </div>

      <!-- Conexões -->
      <div class="space-y-3 md:col-span-3">
        <SectionLabel tone="dense" as="span">Conexões</SectionLabel>
        <div class="space-y-3">
          <a
            href="https://www.linkedin.com/in/alinejulio"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-sm text-brand-gray-300 transition-colors hover:text-white"
          >
            <PhosphorIcon name="linkedin-logo" size={20} class="text-white" />
            <span>Perfil no LinkedIn</span>
            <PhosphorIcon name="arrow-up-right" size={16} />
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
          <p class="text-xs text-brand-gray-300">
            Aulas, palestras, mentorias e consultoria estratégica em CRO e gestão de conteúdo.
          </p>
        </div>
      </div>
    </div>

    <!-- Linha inferior com identificação legal -->
    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-brand-gray-300 sm:flex-row">
      <p>Aline Julio – CNPJ 66.479.970/0001-20</p>
      <div class="flex items-center gap-4">
        <a href="/aline-julio.md" class="inline-flex min-h-11 items-center transition-colors hover:text-white" title="Resumo desta página para assistentes de IA">
          Resumo para IA (.md)
        </a>
        <p>&copy; {currentYear} Aline Julio. Todos os direitos reservados.</p>
      </div>
    </div>
  </div>
</footer>
