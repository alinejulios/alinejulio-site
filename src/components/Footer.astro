---
import Logo from './Logo.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import SectionLabel from './SectionLabel.astro';
import { LINKS, RAZAO_SOCIAL, CNPJ } from '../data/site';
import { CTA } from '../data/contato';

const currentYear = new Date().getFullYear();

const redes = [
  { href: LINKS.linkedin, label: CTA.linkedin.label, icon: 'linkedin-logo' },
  { href: LINKS.instagram, label: 'Instagram (@_alinejulios)', icon: 'instagram-logo' },
  { href: LINKS.x, label: 'X (@_alinejulios)', icon: 'x-logo' },
] as const;
---

<footer class="border-t-4 border-brand-red bg-brand-black pb-[88px] pt-16 text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 border-b border-brand-gray-700 pb-12 md:grid-cols-12">

      <!-- Marca e posicionamento -->
      <div class="space-y-4 md:col-span-6">
        <Logo variant="dark" />
        <p class="max-w-md pt-2 text-sm leading-relaxed text-brand-gray-300">
          CRO Specialist, Content Designer e UX Writer. Desde 2019 em dados, SEO On-Page e gestão de conteúdo.
        </p>
      </div>

      <!-- Navegação -->
      <div class="space-y-3 md:col-span-3">
        <SectionLabel tone="dense" as="span">Navegação</SectionLabel>
        <ul class="text-sm text-brand-gray-300">
          <li><a href="/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Início</a></li>
          <li><a href="/sobre/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Sobre Aline Julio</a></li>
          <li><a href="/palestras/" class="inline-flex min-h-11 items-center transition-colors hover:text-white">Palestras e aulas</a></li>
        </ul>
      </div>

      <!-- Contato -->
      <div class="space-y-3 md:col-span-3">
        <SectionLabel tone="dense" as="span">Contato</SectionLabel>
        <ul class="text-sm text-brand-gray-300">
          {redes.map((rede) => (
            <li>
              <a
                href={rede.href}
                target="_blank"
                rel="me noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-white"
              >
                <PhosphorIcon name={rede.icon} size={20} class="text-white" />
                <span>{rede.label}</span>
                <span class="sr-only"> (abre em nova aba)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Linha inferior com identificação legal -->
    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-brand-gray-300 sm:flex-row">
      <p>{RAZAO_SOCIAL} · CNPJ {CNPJ}</p>
      <div class="flex flex-col items-center gap-x-4 sm:flex-row">
        <a href="/aline-julio.md" class="inline-flex min-h-11 items-center transition-colors hover:text-white" title="Resumo desta página para assistentes de IA">
          Resumo para IA (.md)
        </a>
        <p>&copy; {currentYear} Aline Julio. Todos os direitos reservados.</p>
      </div>
    </div>
  </div>
</footer>
