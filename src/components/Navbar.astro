---
import Logo from './Logo.astro';
import PhosphorIcon from './PhosphorIcon.astro';

const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/palestras', label: 'Palestras & Aulas' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur border-b border-brand-gray-300/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logotipo Oficial com Área de Proteção -->
    <div class="py-2">
      <Logo variant="light" subtitle="CRO | UX | Content" size="md" />
    </div>

    <!-- Navegação Desktop -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegação Principal">
      {navLinks.map((link) => {
        const isActive = cleanPath === link.href || (link.href !== '/' && cleanPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`font-sans text-sm font-semibold transition-colors duration-150 py-1 border-b-2 ${
              isActive
                ? 'text-brand-red border-brand-red'
                : 'text-brand-black border-transparent hover:text-brand-red'
            }`}
          >
            {link.label}
          </a>
        );
      })}

      <!-- Botão CTA LinkedIn -->
      <a
        href="https://www.linkedin.com/in/alinejulio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-brand-black hover:bg-brand-red text-white text-xs uppercase tracking-wider font-bold px-4 py-2.5 rounded-lg transition-all duration-200 shadow-sm hover:shadow"
      >
        <PhosphorIcon name="linkedin" size={16} color="white" />
        <span>LinkedIn</span>
        <PhosphorIcon name="arrow-up-right" size={14} color="white" />
      </a>
    </nav>

    <!-- Menu Mobile Toggle (JavaScript Vanilla Acessível) -->
    <div class="flex items-center md:hidden gap-3">
      <a
        href="https://www.linkedin.com/in/alinejulio"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center p-2 rounded-lg bg-brand-black text-white hover:bg-brand-red transition-colors"
        aria-label="Acessar LinkedIn de Aline Julio"
      >
        <PhosphorIcon name="linkedin" size={18} color="white" />
      </a>
      <button
        id="mobile-menu-button"
        type="button"
        class="p-2 text-brand-black hover:text-brand-red focus:outline-none"
        aria-label="Abrir Menu de Navegação"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Painel Mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-gray-300/40 bg-white px-4 pt-3 pb-6 space-y-3">
    {navLinks.map((link) => {
      const isActive = cleanPath === link.href;
      return (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-md font-sans text-base font-semibold ${
            isActive ? 'text-brand-red bg-brand-ice' : 'text-brand-black hover:bg-brand-ice'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-2">
      <a
        href="https://www.linkedin.com/in/alinejulio"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full bg-brand-red text-white py-3 rounded-lg font-bold text-sm tracking-wider uppercase"
      >
        <PhosphorIcon name="linkedin" size={18} color="white" />
        <span>Conectar no LinkedIn</span>
      </a>
    </div>
  </div>
</header>

<!--
  Servido como arquivo estático (mesma origem) em vez de script inline/bundlado,
  para que a Content Security Policy (ver vercel.json) não precise de
  'unsafe-inline' nem de hashes por conteúdo em script-src.
-->
<script is:inline src="/scripts/navbar-menu.js" defer></script>
