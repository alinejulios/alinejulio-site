---
import Logo from './Logo.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import { CTA } from '../data/contato';

const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre/', label: 'Sobre' },
  { href: '/palestras/', label: 'Palestras e aulas' },
];

const isActive = (href: string) => (href === '/' ? cleanPath === '/' : cleanPath.startsWith(href));
---

<header class="sticky top-0 z-50 w-full border-b border-brand-gray-300 bg-white">
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <Logo variant="light" />

    <!-- Navegação desktop -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Navegação principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`inline-flex min-h-11 items-center border-b-2 text-sm font-semibold transition-colors duration-150 ${
            isActive(link.href)
              ? 'border-brand-red text-brand-red'
              : 'border-transparent text-brand-black hover:text-brand-red'
          }`}
        >
          {link.label}
        </a>
      ))}

      <a
        href={CTA.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary px-4 text-sm"
      >
        <PhosphorIcon name="linkedin-logo" size={20} />
        <span>{CTA.linkedin.label}</span>
        <PhosphorIcon name="arrow-up-right" size={16} />
        <span class="sr-only"> (abre em nova aba)</span>
      </a>
    </nav>

    <!-- Menu mobile -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={CTA.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md text-brand-black transition-colors hover:text-brand-red"
        aria-label="LinkedIn de Aline Julio (abre em nova aba)"
      >
        <PhosphorIcon name="linkedin-logo" size={24} />
      </a>
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md text-brand-black transition-colors hover:text-brand-red"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-icon="open"><PhosphorIcon name="list" size={24} /></span>
        <span data-icon="close" class="hidden"><PhosphorIcon name="x" size={24} /></span>
      </button>
    </div>
  </div>

  <!-- Painel mobile -->
  <nav id="mobile-menu" aria-label="Navegação principal" class="hidden space-y-2 border-t border-brand-gray-300 bg-white px-4 pb-6 pt-3 md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
        class={`flex min-h-11 items-center rounded-md px-3 text-base font-semibold ${
          isActive(link.href) ? 'bg-brand-ice text-brand-red' : 'text-brand-black hover:bg-brand-ice'
        }`}
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2">
      <a
        href={CTA.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary w-full"
      >
        <PhosphorIcon name="linkedin-logo" size={20} />
        <span>{CTA.linkedin.label}</span>
        <span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>
  </nav>
</header>

<!--
  Servido como arquivo estático (mesma origem) em vez de script inline/bundlado,
  para que a Content Security Policy (ver vercel.json) não precise de
  'unsafe-inline' nem de hashes por conteúdo em script-src.
-->
<script is:inline src="/scripts/navbar-menu.js" defer></script>
