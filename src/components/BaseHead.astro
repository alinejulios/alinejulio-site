---
// Apenas o subset "latin" (cobre acentuação em PT-BR) de cada peso, em vez das 7
// variantes de idioma que o @fontsource carrega por padrão — menos requisições de fonte.
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import montserrat500 from '@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url';
import montserrat600 from '@fontsource/montserrat/files/montserrat-latin-600-normal.woff2?url';
import montserrat700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import montserrat800 from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';
import montserrat900 from '@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Aline Julio é CRO Specialist e Estrategista de Marketing com mais de 7 anos de experiência, unindo análise de dados, SEO On-Page e estratégia orientada a metas de negócio.',
  image = '/images/aline-julio-logo.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteTitle = title.includes('Aline Julio') ? title : `${title} | Aline Julio`;

const fontFaceCSS = [400, 500, 600, 700, 800, 900]
  .map((weight, i) => {
    const url = [montserrat400, montserrat500, montserrat600, montserrat700, montserrat800, montserrat900][i];
    return `@font-face{font-family:'Montserrat';font-style:normal;font-weight:${weight};font-display:optional;src:url(${url}) format('woff2');}`;
  })
  .join('\n');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />

<!-- Preload dos pesos mais usados acima da dobra (corpo de texto e títulos) -->
<link rel="preload" as="font" type="font/woff2" href={montserrat400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={montserrat900} crossorigin />

<!--
  font-display: optional (em vez do "swap" padrão do @fontsource) evita o reflow de
  texto que causava Cumulative Layout Shift: com pesos 900/800 em títulos grandes, a
  troca da fonte de fallback para a Montserrat mudava a quebra de linha depois do
  primeiro paint. Com "optional" a fonte só é usada se já estiver pronta a tempo.
-->
<style is:global set:html={fontFaceCSS}></style>

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content="Aline Julio" />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content="Aline Julio" />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Theme Color -->
<meta name="theme-color" content="#E32227" />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WD92JJ901K"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-WD92JJ901K');
</script>
