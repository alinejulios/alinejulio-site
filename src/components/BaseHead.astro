---
// Apenas o subset "latin" (cobre acentuação em PT-BR) de cada peso, em vez das 7
// variantes de idioma que o @fontsource carrega por padrão — menos requisições de fonte.
import montserrat300italic from '@fontsource/montserrat/files/montserrat-latin-300-italic.woff2?url';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import montserrat500 from '@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url';
import montserrat600 from '@fontsource/montserrat/files/montserrat-latin-600-normal.woff2?url';
import montserrat700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import montserrat800 from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';
import { DESCRICAO_3A_PESSOA, OG_IMAGE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description = DESCRICAO_3A_PESSOA,
  image = OG_IMAGE,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
} = Astro.props;

const siteTitle = title.includes('Aline Julio') ? title : `${title} | Aline Julio`;

// Pesos em uso: 300 itálico (citação), 400, 500, 600, 700 e 800 (títulos).
const fontFaces: [number, 'normal' | 'italic', string][] = [
  [300, 'italic', montserrat300italic],
  [400, 'normal', montserrat400],
  [500, 'normal', montserrat500],
  [600, 'normal', montserrat600],
  [700, 'normal', montserrat700],
  [800, 'normal', montserrat800],
];
const fontFaceCSS = fontFaces
  .map(([weight, style, url]) => `@font-face{font-family:'Montserrat';font-style:${style};font-weight:${weight};font-display:optional;src:url(${url}) format('woff2');}`)
  .join('\n');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{!noindex && <link rel="canonical" href={canonicalUrl} />}
<meta name="generator" content={Astro.generator} />

<!-- Preload dos pesos mais usados acima da dobra (corpo de texto e títulos) -->
<link rel="preload" as="font" type="font/woff2" href={montserrat400} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={montserrat800} crossorigin />

<!--
  font-display: optional (em vez do "swap" padrão do @fontsource) evita o reflow de
  texto que causava Cumulative Layout Shift: com peso 800 em títulos grandes, a
  troca da fonte de fallback para a Montserrat mudava a quebra de linha depois do
  primeiro paint. Com "optional" a fonte só é usada se já estiver pronta a tempo.
-->
<style is:global set:html={fontFaceCSS}></style>

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content="Aline Julio" />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Aline Julio palestrando no palco do SEOcamp" />
<meta property="og:site_name" content="Aline Julio" />
<meta property="og:locale" content="pt_BR" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />

<!-- Theme Color -->
<meta name="theme-color" content="#E32227" />

<!--
  Google tag (gtag.js). O trecho de inicialização mora em /scripts/ga4-init.js
  (mesma origem) em vez de inline, para que a Content Security Policy (ver
  vercel.json) não precise de 'unsafe-inline' em script-src. Ele também é
  quem injeta o gtag.js (~157KB) somente depois do evento "load" da página,
  tirando esse script pesado do caminho crítico de renderização (PageSpeed:
  "reduza o JavaScript não usado" / árvore de dependências da rede).
-->
<script is:inline src="/scripts/ga4-init.js" defer></script>
