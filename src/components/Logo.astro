---
interface Props {
  variant?: 'light' | 'dark'; // 'light' is for light backgrounds, 'dark' is for dark backgrounds
  subtitle?: 'CRO | UX | Content' | 'conteúdo autêntico' | 'Consultoria' | 'none';
  size?: 'sm' | 'md' | 'lg';
  showIcon?: boolean;
  useFullSvg?: boolean;
}

const {
  variant = 'light',
  subtitle = 'CRO | UX | Content',
  size = 'md',
  showIcon = true,
  useFullSvg = false,
} = Astro.props;

const isDark = variant === 'dark';

// Sizes
const iconSizes = {
  sm: 'w-8 h-8',
  md: 'w-10 h-10 md:w-11 md:h-11',
  lg: 'w-14 h-14 md:w-16 md:h-16',
};

const titleSizes = {
  sm: 'text-lg leading-tight',
  md: 'text-2xl leading-none',
  lg: 'text-3xl leading-none',
};

const subtitleSizes = {
  sm: 'text-[9px] tracking-wider',
  md: 'text-[11px] tracking-wider',
  lg: 'text-xs tracking-wider',
};
---

<a href="/" class="group inline-flex items-center gap-3 transition-opacity hover:opacity-95" aria-label="Aline Julio - Início">
  {useFullSvg ? (
    <img
      src={isDark ? "/images/logo-horizontal-white.svg" : "/images/logo-horizontal-red.svg"}
      alt="Aline Julio - Conteúdo Autêntico"
      class="h-9 md:h-11 w-auto"
    />
  ) : (
    <>
      {showIcon && (
        <div class={`flex-shrink-0 ${iconSizes[size]} transition-transform duration-200 group-hover:scale-105`}>
          {/* SVG original e estrito do logotipo oficial (balão de fala + aspas vetorizadas) */}
          <svg
            class="w-full h-full drop-shadow-sm"
            viewBox="0 0 2250 2250"
            version="1.1"
            xmlns="http://www.w3.org/2000/svg"
            style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
            aria-hidden="true"
          >
            <g transform="matrix(2.08333,0,0,2.08333,0,0)">
              <g id="Fundo-vermelho-arredondado" transform="matrix(1,0,0,1,0.37436,4.33388)">
                <path
                  d="M1078.29,229.803C1078.29,102.311 974.786,-1.197 847.294,-1.197L231.957,-1.197C104.465,-1.197 0.957,102.311 0.957,229.803L0.957,841.529C0.957,969.021 104.465,1072.53 231.957,1072.53L847.294,1072.53C974.786,1072.53 1078.29,969.021 1078.29,841.529L1078.29,229.803Z"
                  fill="#e32227"
                />
              </g>
              <g id="Logo---ícone">
                <g id="Balão" transform="matrix(-1.43325,0,0,1.38134,1327.48,-210.532)">
                  <path
                    d="M262.72,334.309L261.227,772.789L626.462,805.95L626.05,879.982L837.414,687.969L837.656,250.935L419.83,206.688L262.72,334.309ZM278.043,342.089L424.423,223.184L822.298,265.318L822.068,680.741L641.597,844.69L641.893,791.363L276.626,758.2L278.043,342.089Z"
                    fill="#fff"
                  />
                </g>
                <g id="Aspas" transform="matrix(2.58278,0,0,2.58278,-696.615,23.6546)">
                  <g transform="matrix(288,0,0,288,407.418,364.655)">
                    <path
                      d="M0.218,-0.742L0.152,-0.502L0.13,-0.592C0.159,-0.592 0.182,-0.584 0.2,-0.567C0.218,-0.55 0.227,-0.527 0.227,-0.498C0.227,-0.469 0.218,-0.446 0.2,-0.429C0.181,-0.411 0.158,-0.402 0.131,-0.402C0.103,-0.402 0.08,-0.411 0.062,-0.429C0.043,-0.446 0.034,-0.469 0.034,-0.498C0.034,-0.507 0.035,-0.515 0.036,-0.524C0.037,-0.532 0.04,-0.542 0.044,-0.553C0.048,-0.564 0.054,-0.579 0.061,-0.598L0.119,-0.742L0.218,-0.742ZM0.454,-0.742L0.388,-0.502L0.366,-0.592C0.395,-0.592 0.418,-0.584 0.436,-0.567C0.454,-0.55 0.463,-0.527 0.463,-0.498C0.463,-0.469 0.454,-0.446 0.436,-0.429C0.417,-0.411 0.394,-0.402 0.367,-0.402C0.339,-0.402 0.316,-0.411 0.298,-0.429C0.279,-0.446 0.27,-0.469 0.27,-0.498C0.27,-0.507 0.271,-0.515 0.272,-0.524C0.273,-0.532 0.276,-0.542 0.28,-0.553C0.284,-0.564 0.29,-0.579 0.297,-0.598L0.355,-0.742L0.454,-0.742Z"
                      fill="#fff"
                      fill-rule="nonzero"
                    />
                  </g>
                </g>
              </g>
            </g>
          </svg>
        </div>
      )}

      <div class="flex flex-col">
        <span class={`font-sans font-black tracking-tight ${titleSizes[size]} ${isDark ? 'text-white' : 'text-brand-red'}`}>
          Aline Julio
        </span>
        {subtitle !== 'none' && (
          <span class={`font-sans font-medium uppercase mt-0.5 ${subtitleSizes[size]} ${isDark ? 'text-brand-gray-300' : 'text-brand-black'}`}>
            {subtitle}
          </span>
        )}
      </div>
    </>
  )}
</a>
