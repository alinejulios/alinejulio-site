---
// Logotipo: sempre o arquivo oficial, sem sombra, sem animação e sem recriar em HTML.
// Provisório: o lockup empilhado ("Aline" / "Julio" + assinatura "CRO | UX | Content")
// ainda não foi entregue; até lá usamos o lockup horizontal oficial do repositório.
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;
const src = variant === 'dark' ? '/images/logo-horizontal-white.svg' : '/images/logo-horizontal-red.svg';
---

<a href="/" class={`inline-flex items-center ${className}`} aria-label="Aline Julio, página inicial">
  <img src={src} alt="" width="286" height="67" class="h-10 w-auto md:h-11" />
</a>
